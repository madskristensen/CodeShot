<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>
  <Include href="KnownImageIds.vsct"/>
  <Include href="VSGlobals.vsct"/>

  <Commands package="CodeShot">
    <Menus>
      <Menu guid="CodeShot" id="CodeShotToolbar" type="ToolWindowToolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>CodeShot Toolbar</ButtonText>
        </Strings>
      </Menu>

      <Menu guid="CodeShot" id="OptionsMenu" priority="0x0100" type="MenuController">
        <Parent guid="CodeShot" id="ToolbarOptionsGroup" />
        <Icon guid="ImageCatalogGuid" id="Settings" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>NotInTBList</CommandFlag>
        <Strings>
          <ButtonText>Options</ButtonText>
          <ToolTipText>Screenshot options</ToolTipText>
        </Strings>
      </Menu>

      <Menu guid="CodeShot" id="AnnotationMenu" priority="0x0100" type="MenuController">
        <Parent guid="CodeShot" id="ToolbarAnnotationGroup" />
        <Icon guid="ImageCatalogGuid" id="Edit" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>NotInTBList</CommandFlag>
        <Strings>
          <ButtonText>Annotate</ButtonText>
          <ToolTipText>Draw annotations over the code</ToolTipText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="CodeShot" id="MyMenuGroup" priority="0x0600">
        <Parent guid="VSMainMenu" id="Tools"/>
      </Group>

      <Group guid="CodeShot" id="ToolWindowContextGroup" priority="0x0180">
        <Parent guid="VSMainMenu" id="IDM_VS_CTXT_DOCKEDWINDOW" />
      </Group>

      <Group guid="CodeShot" id="ToolbarActionsGroup" priority="0x0100">
        <Parent guid="CodeShot" id="CodeShotToolbar" />
      </Group>

      <Group guid="CodeShot" id="ToolbarAnnotationGroup" priority="0x0200">
        <Parent guid="CodeShot" id="CodeShotToolbar" />
      </Group>

      <Group guid="CodeShot" id="ToolbarFontGroup" priority="0x0300">
        <Parent guid="CodeShot" id="CodeShotToolbar" />
      </Group>

      <Group guid="CodeShot" id="ToolbarOptionsGroup" priority="0x0400">
        <Parent guid="CodeShot" id="CodeShotToolbar" />
      </Group>

      <Group guid="CodeShot" id="AnnotationMenuToolsGroup" priority="0x0100">
        <Parent guid="CodeShot" id="AnnotationMenu" />
      </Group>

      <Group guid="CodeShot" id="AnnotationMenuActionsGroup" priority="0x0200">
        <Parent guid="CodeShot" id="AnnotationMenu" />
      </Group>

      <!-- Line numbering has two settings that only make sense together, so they get their own
           group and the separator that comes with it. -->
      <Group guid="CodeShot" id="OptionsMenuLineNumbersGroup" priority="0x0050">
        <Parent guid="CodeShot" id="OptionsMenu" />
      </Group>

      <Group guid="CodeShot" id="OptionsMenuGroup" priority="0x0100">
        <Parent guid="CodeShot" id="OptionsMenu" />
      </Group>

      <Group guid="CodeShot" id="OptionsMenuSettingsGroup" priority="0x0200">
        <Parent guid="CodeShot" id="OptionsMenu" />
      </Group>
    </Groups>

    <!--This section defines the elements the user can interact with, like a menu command or a button
        or combo box in a toolbar. -->
    <Buttons>
      <Button guid="CodeShot" id="ShowCodeShotWindowCommand" priority="0x0100" type="Button">
        <Parent guid="CodeShot" id="MyMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Camera" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Take Screenshot</ButtonText>
          <LocCanonicalName>.CodeShot.TakeTextEditorScreenshot</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="CaptureMenuCommand" priority="0x0190" type="Button">
        <Parent guid="CodeShot" id="ToolbarActionsGroup" />
        <Icon guid="ImageCatalogGuid" id="Timer" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Capture Foreground UI in 5 Seconds</ButtonText>
          <ToolTipText>Open a Visual Studio menu, context menu, or dialog before the timer expires</ToolTipText>
          <LocCanonicalName>.CodeShot.CaptureForegroundUI</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="CopyToolWindowScreenshotCommand" priority="0x0100" type="Button">
        <Parent guid="CodeShot" id="ToolWindowContextGroup" />
        <Icon guid="ImageCatalogGuid" id="Camera" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Take Screenshot</ButtonText>
          <ToolTipText>Open a screenshot of this tool window in CodeShot</ToolTipText>
          <LocCanonicalName>.CodeShot.TakeToolWindowScreenshot</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="RefreshPreviewCommand" priority="0x0100" type="Button">
        <Parent guid="CodeShot" id="ToolbarActionsGroup" />
        <Icon guid="ImageCatalogGuid" id="Refresh" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Refresh Preview</ButtonText>
          <ToolTipText>Update the preview from the current editor selection</ToolTipText>
          <LocCanonicalName>.CodeShot.RefreshPreview</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="CropImageCommand" priority="0x0180" type="Button">
        <Parent guid="CodeShot" id="ToolbarActionsGroup" />
        <Icon guid="ImageCatalogGuid" id="ImageCrop" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Crop Tool Window Capture</ButtonText>
          <ToolTipText>Drag to crop the captured tool window</ToolTipText>
          <LocCanonicalName>.CodeShot.CropToolWindowCapture</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="CopyImageCommand" priority="0x0200" type="Button">
        <Parent guid="CodeShot" id="ToolbarActionsGroup" />
        <Icon guid="ImageCatalogGuid" id="Copy" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Copy Image</ButtonText>
          <ToolTipText>Copy the screenshot to the clipboard</ToolTipText>
          <LocCanonicalName>.CodeShot.CopyImage</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="SaveImageCommand" priority="0x0300" type="Button">
        <Parent guid="CodeShot" id="ToolbarActionsGroup" />
        <Icon guid="ImageCatalogGuid" id="SaveAs" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Save Image As...</ButtonText>
          <ToolTipText>Save the screenshot as a PNG file</ToolTipText>
          <LocCanonicalName>.CodeShot.SaveImage</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="ShowLineNumbersCommand" priority="0x0100" type="Button">
        <Parent guid="CodeShot" id="OptionsMenuLineNumbersGroup" />
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Line Numbers</ButtonText>
          <ToolTipText>Show line numbers in the screenshot</ToolTipText>
          <LocCanonicalName>.CodeShot.ShowLineNumbers</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="UseRealLineNumbersCommand" priority="0x0200" type="Button">
        <Parent guid="CodeShot" id="OptionsMenuLineNumbersGroup" />
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Real Line Numbers</ButtonText>
          <ToolTipText>Number the lines from their position in the file instead of from 1</ToolTipText>
          <LocCanonicalName>.CodeShot.UseRealLineNumbers</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="ShowTitleBarCommand" priority="0x0200" type="Button">
        <Parent guid="CodeShot" id="OptionsMenuGroup" />
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Title Bar</ButtonText>
          <ToolTipText>Show the file name title bar in the screenshot</ToolTipText>
          <LocCanonicalName>.CodeShot.ShowTitleBar</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="KeepIndentationCommand" priority="0x0400" type="Button">
        <Parent guid="CodeShot" id="OptionsMenuGroup" />
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Keep Original Indentation</ButtonText>
          <ToolTipText>Keep the leading whitespace of the selection instead of trimming it</ToolTipText>
          <LocCanonicalName>.CodeShot.KeepIndentation</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="ClearHighlightsCommand" priority="0x0500" type="Button">
        <Parent guid="CodeShot" id="OptionsMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="ClearWindowContent" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Clear Line Highlights</ButtonText>
          <ToolTipText>Remove all line highlights from the preview</ToolTipText>
          <LocCanonicalName>.CodeShot.ClearHighlights</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="SelectAnnotationCommand" priority="0x0100" type="Button">
        <Parent guid="CodeShot" id="AnnotationMenuToolsGroup" />
        <Icon guid="ImageCatalogGuid" id="Cursor" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <CommandFlag>FixMenuController</CommandFlag>
        <Strings>
          <ButtonText>Select / Highlight Lines</ButtonText>
          <ToolTipText>Click code lines to highlight them</ToolTipText>
          <LocCanonicalName>.CodeShot.AnnotationSelect</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="RectangleAnnotationCommand" priority="0x0200" type="Button">
        <Parent guid="CodeShot" id="AnnotationMenuToolsGroup" />
        <Icon guid="ImageCatalogGuid" id="OutlinedRectangle" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Rectangle</ButtonText>
          <ToolTipText>Draw an outline around part of the code</ToolTipText>
          <LocCanonicalName>.CodeShot.AnnotationRectangle</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="ArrowAnnotationCommand" priority="0x0300" type="Button">
        <Parent guid="CodeShot" id="AnnotationMenuToolsGroup" />
        <Icon guid="ImageCatalogGuid" id="LineArrow" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Arrow</ButtonText>
          <ToolTipText>Draw an arrow toward part of the code</ToolTipText>
          <LocCanonicalName>.CodeShot.AnnotationArrow</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="HighlightAnnotationCommand" priority="0x0400" type="Button">
        <Parent guid="CodeShot" id="AnnotationMenuToolsGroup" />
        <Icon guid="ImageCatalogGuid" id="Highlighter" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Highlighter</ButtonText>
          <ToolTipText>Highlight an expression or identifier</ToolTipText>
          <LocCanonicalName>.CodeShot.AnnotationHighlight</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="TextAnnotationCommand" priority="0x0500" type="Button">
        <Parent guid="CodeShot" id="AnnotationMenuToolsGroup" />
        <Icon guid="ImageCatalogGuid" id="NewTextAnnotation" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Text</ButtonText>
          <ToolTipText>Add a text callout</ToolTipText>
          <LocCanonicalName>.CodeShot.AnnotationText</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="RedactAnnotationCommand" priority="0x0600" type="Button">
        <Parent guid="CodeShot" id="AnnotationMenuToolsGroup" />
        <Icon guid="ImageCatalogGuid" id="FilledRectangle" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Redact</ButtonText>
          <ToolTipText>Cover sensitive content with an opaque block</ToolTipText>
          <LocCanonicalName>.CodeShot.AnnotationRedact</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="EraserAnnotationCommand" priority="0x0700" type="Button">
        <Parent guid="CodeShot" id="AnnotationMenuToolsGroup" />
        <Icon guid="ImageCatalogGuid" id="Eraser" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Eraser</ButtonText>
          <ToolTipText>Remove an annotation</ToolTipText>
          <LocCanonicalName>.CodeShot.AnnotationEraser</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="ClearAnnotationsCommand" priority="0x0100" type="Button">
        <Parent guid="CodeShot" id="AnnotationMenuActionsGroup" />
        <Icon guid="ImageCatalogGuid" id="ClearWindowContent" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Clear Annotations</ButtonText>
          <ToolTipText>Remove all annotations from the preview</ToolTipText>
          <LocCanonicalName>.CodeShot.ClearAnnotations</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="UndoAnnotationCommand" priority="0x0200" type="Button">
        <Parent guid="CodeShot" id="AnnotationMenuActionsGroup" />
        <Icon guid="ImageCatalogGuid" id="Undo" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Undo</ButtonText>
          <ToolTipText>Undo the last annotation or crop</ToolTipText>
          <LocCanonicalName>.CodeShot.UndoAnnotation</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="RedoAnnotationCommand" priority="0x0300" type="Button">
        <Parent guid="CodeShot" id="AnnotationMenuActionsGroup" />
        <Icon guid="ImageCatalogGuid" id="Redo" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Redo</ButtonText>
          <ToolTipText>Redo the last undone annotation or crop</ToolTipText>
          <LocCanonicalName>.CodeShot.RedoAnnotation</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="CodeShot" id="OpenOptionsCommand" priority="0x0100" type="Button">
        <Parent guid="CodeShot" id="OptionsMenuSettingsGroup" />
        <Icon guid="ImageCatalogGuid" id="Settings" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>FixMenuController</CommandFlag>
        <Strings>
          <ButtonText>Options...</ButtonText>
          <ToolTipText>Open the CodeShot options page</ToolTipText>
          <LocCanonicalName>.CodeShot.Options</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>

    <Combos>
      <Combo guid="CodeShot" id="FontFamilyCombo" priority="0x0100" type="DropDownCombo" defaultWidth="150" idCommandList="FontFamilyComboList">
        <Parent guid="CodeShot" id="ToolbarFontGroup" />
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Font</ButtonText>
          <ToolTipText>Font used in the screenshot</ToolTipText>
          <LocCanonicalName>.CodeShot.Font</LocCanonicalName>
        </Strings>
      </Combo>

      <Combo guid="CodeShot" id="FontSizeCombo" priority="0x0200" type="DynamicCombo" defaultWidth="50" idCommandList="FontSizeComboList">
        <Parent guid="CodeShot" id="ToolbarFontGroup" />
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Font Size</ButtonText>
          <ToolTipText>Font size used in the screenshot</ToolTipText>
          <LocCanonicalName>.CodeShot.FontSize</LocCanonicalName>
        </Strings>
      </Combo>
    </Combos>

  </Commands>

  <KeyBindings>
    <KeyBinding guid="CodeShot" id="ShowCodeShotWindowCommand" editor="guidVSStd97" key1="P" mod1="Control Shift" />

    <!-- The editor attribute is the command UI context of the active window, so these two only beat
         the global Edit.Copy and File.SaveSelectedItems while the CodeShot window has focus. -->
    <KeyBinding guid="CodeShot" id="CopyImageCommand" editor="CodeShotToolWindow" key1="C" mod1="Control" />
    <KeyBinding guid="CodeShot" id="SaveImageCommand" editor="CodeShotToolWindow" key1="S" mod1="Control" />
    <KeyBinding guid="CodeShot" id="UndoAnnotationCommand" editor="CodeShotToolWindow" key1="Z" mod1="Control" />
    <KeyBinding guid="CodeShot" id="RedoAnnotationCommand" editor="CodeShotToolWindow" key1="Y" mod1="Control" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="CodeShot" value="{a7a7b4b8-f629-4a80-9156-c3dcaae4256a}">
      <IDSymbol name="MyMenuGroup" value="0x0001" />
      <IDSymbol name="ToolWindowContextGroup" value="0x0002" />
      <IDSymbol name="ShowCodeShotWindowCommand" value="0x0100" />
      <IDSymbol name="CopyToolWindowScreenshotCommand" value="0x0101" />
      <IDSymbol name="CaptureMenuCommand" value="0x0102" />

      <IDSymbol name="CodeShotToolbar" value="0x1000" />
      <IDSymbol name="ToolbarActionsGroup" value="0x1010" />
      <IDSymbol name="ToolbarFontGroup" value="0x1020" />
      <IDSymbol name="ToolbarOptionsGroup" value="0x1030" />
      <IDSymbol name="OptionsMenu" value="0x1040" />
      <IDSymbol name="OptionsMenuGroup" value="0x1050" />
      <IDSymbol name="OptionsMenuSettingsGroup" value="0x1060" />
      <IDSymbol name="OptionsMenuLineNumbersGroup" value="0x1070" />
      <IDSymbol name="ToolbarAnnotationGroup" value="0x1080" />
      <IDSymbol name="AnnotationMenuToolsGroup" value="0x1090" />
      <IDSymbol name="AnnotationMenuActionsGroup" value="0x10A0" />
      <IDSymbol name="AnnotationMenu" value="0x10B0" />

      <IDSymbol name="RefreshPreviewCommand" value="0x0110" />
      <IDSymbol name="CopyImageCommand" value="0x0120" />
      <IDSymbol name="SaveImageCommand" value="0x0130" />
      <IDSymbol name="ShowLineNumbersCommand" value="0x0140" />
      <IDSymbol name="ShowTitleBarCommand" value="0x0150" />
      <IDSymbol name="UseRealLineNumbersCommand" value="0x0190" />
      <IDSymbol name="KeepIndentationCommand" value="0x01A0" />
      <IDSymbol name="ClearHighlightsCommand" value="0x01B0" />
      <IDSymbol name="SelectAnnotationCommand" value="0x01C0" />
      <IDSymbol name="RectangleAnnotationCommand" value="0x01D0" />
      <IDSymbol name="RedactAnnotationCommand" value="0x01E0" />
      <IDSymbol name="EraserAnnotationCommand" value="0x01F0" />
      <IDSymbol name="ClearAnnotationsCommand" value="0x0200" />
      <IDSymbol name="ArrowAnnotationCommand" value="0x0210" />
      <IDSymbol name="HighlightAnnotationCommand" value="0x0220" />
      <IDSymbol name="TextAnnotationCommand" value="0x0230" />
      <IDSymbol name="UndoAnnotationCommand" value="0x0240" />
      <IDSymbol name="RedoAnnotationCommand" value="0x0250" />
      <IDSymbol name="CropImageCommand" value="0x0260" />
      <IDSymbol name="OpenOptionsCommand" value="0x0180" />

      <IDSymbol name="FontFamilyCombo" value="0x0160" />
      <IDSymbol name="FontFamilyComboList" value="0x0161" />
      <IDSymbol name="FontSizeCombo" value="0x0170" />
      <IDSymbol name="FontSizeComboList" value="0x0171" />
    </GuidSymbol>

    <!-- The tool window's persistence GUID, which is also its key binding scope. -->
    <GuidSymbol name="CodeShotToolWindow" value="{ce9b4700-7154-4196-9957-858230f19734}" />
  </Symbols>
</CommandTable>

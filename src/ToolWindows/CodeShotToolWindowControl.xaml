<UserControl
    x:Class="CodeShot.ToolWindows.CodeShotToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
    xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
    xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
    toolkit:Themes.UseVsTheme="True"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="ZoomSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Height="18" Background="Transparent">
                            <Border
                                Height="2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" />
                            <Track
                                x:Name="PART_Track"
                                VerticalAlignment="Center"
                                IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                Maximum="{TemplateBinding Maximum}"
                                Minimum="{TemplateBinding Minimum}"
                                Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Static Slider.DecreaseLarge}"
                                        Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="{TemplateBinding Background}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Static Slider.IncreaseLarge}"
                                        Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="{TemplateBinding Background}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb
                                        Width="8"
                                        Height="16"
                                        Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}"
                                        BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextWidthThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="{TemplateBinding Background}">
                            <Border
                                x:Name="HoverIndicator"
                                Width="2"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}"
                                Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverIndicator" Property="Opacity" Value="0.35" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="HoverIndicator" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            x:Name="PreviewScrollViewer"
            Grid.Row="0"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            Padding="10"
            PreviewMouseWheel="OnPreviewMouseWheel">
            <!-- Zoom is applied outside the capture surface so annotations use image coordinates and
                 exported images remain independent of the on-screen preview scale. The wrapper
                 measures the capture surface at its content height instead of stretching it to the viewport. -->
            <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>

                <!-- The capture surface is the exported image, so it must never be clipped to the viewport. -->
                <!-- The text options are chosen for an exported image rather than for a screen. Ideal
                     formatting keeps the true glyph advances instead of rounding them to whole pixels,
                     Grayscale avoids the color fringes that subpixel rendering would bake into a PNG
                     that can land on any background, and Animated hinting turns off the stem snapping
                     that otherwise makes the letters look hard edged and unevenly weighted. -->
                <Border
                    x:Name="CaptureSurface"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    SnapsToDevicePixels="True"
                    TextOptions.TextFormattingMode="Ideal"
                    TextOptions.TextRenderingMode="Grayscale"
                    TextOptions.TextHintingMode="Animated">
                    <!-- The shadow is layered across two elements, so a wide ambient shadow and a tight
                         contact shadow can be composed into one soft falloff. -->
                    <Border x:Name="ShadowHost">
                        <Border
                            x:Name="SnapshotFrame"
                            MinWidth="320"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border x:Name="TitleBarBorder" Grid.Row="0" Margin="0,0,0,14" Padding="16,10">
                                    <DockPanel x:Name="TitleBar" LastChildFill="True">
                                        <StackPanel
                                            x:Name="MacWindowControls"
                                            DockPanel.Dock="Left"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"
                                            Visibility="Collapsed">
                                            <Ellipse Width="11" Height="11" Margin="0,0,7,0" Fill="#FF5F57" />
                                            <Ellipse Width="11" Height="11" Margin="0,0,7,0" Fill="#FEBC2E" />
                                            <Ellipse Width="11" Height="11" Fill="#28C840" />
                                        </StackPanel>

                                        <StackPanel
                                            x:Name="WindowsWindowControls"
                                            DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0"
                                            Visibility="Collapsed">
                                            <!-- Segoe MDL2 Assets ships with Windows and carries the real caption glyphs. -->
                                            <TextBlock x:Name="MinimizeGlyph" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,14,0" Text="&#xE921;" />
                                            <TextBlock x:Name="MaximizeGlyph" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,14,0" Text="&#xE922;" />
                                            <TextBlock x:Name="CloseGlyph" FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE8BB;" />
                                        </StackPanel>

                                        <TextBlock x:Name="TitleText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                    </DockPanel>
                                </Border>

                                <Grid x:Name="CodeArea" Grid.Row="1" Margin="16,0,16,16" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- The highlight sits under the text and the dimming over it, so the
                                         code stays legible while the lines around it recede. -->
                                    <Canvas
                                        x:Name="HighlightLayer"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Panel.ZIndex="0"
                                        IsHitTestVisible="False" />

                                    <Image
                                        x:Name="CapturedImage"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Panel.ZIndex="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Stretch="None"
                                        Visibility="Collapsed" />

                                    <TextBlock
                                        x:Name="LineNumbersText"
                                        Grid.Column="0"
                                        Panel.ZIndex="1"
                                        TextAlignment="Right"
                                        VerticalAlignment="Top" />

                                    <TextBlock
                                        x:Name="PreviewText"
                                        Grid.Column="2"
                                        Panel.ZIndex="1"
                                        TextWrapping="NoWrap"
                                        VerticalAlignment="Top" />

                                    <RichTextBox
                                        x:Name="WrappedPreview"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Panel.ZIndex="1"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        HorizontalScrollBarVisibility="Disabled"
                                        IsDocumentEnabled="False"
                                        IsReadOnly="True"
                                        VerticalAlignment="Top"
                                        VerticalScrollBarVisibility="Disabled"
                                        Visibility="Collapsed" />

                                    <Canvas
                                        x:Name="DimLayer"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Panel.ZIndex="2"
                                        IsHitTestVisible="False" />

                                    <Canvas
                                        x:Name="AnnotationLayer"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Panel.ZIndex="3"
                                        ClipToBounds="True"
                                        IsHitTestVisible="False" />

                                    <Canvas
                                        x:Name="CropLayer"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Panel.ZIndex="4"
                                        ClipToBounds="True"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </Border>

                <Thumb
                    x:Name="TextWidthThumb"
                    Panel.ZIndex="10"
                    Width="8"
                    Margin="0,0,-4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Cursor="SizeWE"
                    DragCompleted="OnTextWidthDragCompleted"
                    DragDelta="OnTextWidthDragDelta"
                    DragStarted="OnTextWidthDragStarted"
                    Focusable="False"
                    MouseDoubleClick="OnTextWidthThumbDoubleClick"
                    Style="{StaticResource TextWidthThumbStyle}"
                    ToolTip="Drag the right border to resize. Double-click to reset." />
            </Grid>
        </ScrollViewer>
        <Border
            x:Name="EmptyState"
            Grid.Row="0"
            Panel.ZIndex="10"
            Padding="32"
            Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="CodeShot empty state">
            <StackPanel
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextBlock.TextAlignment="Center">
                <imaging:CrispImage
                    Width="48"
                    Height="48"
                    Margin="0,0,0,14"
                    HorizontalAlignment="Center"
                    IsHitTestVisible="False"
                    Moniker="{x:Static catalog:KnownMonikers.Camera}" />
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Create a CodeShot" />
                <TextBlock
                    x:Name="EmptyStateDescription"
                    Margin="0,0,0,14"
                    Text="Open a file and select the code you want to capture."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="EmptyStateShortcut"
                    Margin="0,0,0,8"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}"
                    Text="You can also right-click a tool window's title bar and choose Take Screenshot."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border
            x:Name="MenuCaptureCountdown"
            Grid.Row="0"
            Panel.ZIndex="20"
            Padding="32"
            Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}"
            Visibility="Collapsed"
            AutomationProperties.LiveSetting="Assertive"
            AutomationProperties.Name="Menu capture countdown">
            <StackPanel
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextBlock.TextAlignment="Center">
                <imaging:CrispImage
                    Width="48"
                    Height="48"
                    Margin="0,0,0,14"
                    HorizontalAlignment="Center"
                    IsHitTestVisible="False"
                    Moniker="{x:Static catalog:KnownMonikers.Timer}" />
                <TextBlock
                    x:Name="MenuCaptureCountdownText"
                    Margin="0,0,0,8"
                    FontSize="48"
                    FontWeight="SemiBold"
                    AutomationProperties.LiveSetting="Assertive"
                    Text="5" />
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Open the UI you want to capture" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}"
                    Text="Keep the menu, flyout, or dialog visible until the countdown finishes."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border
            x:Name="LoadingOverlay"
            Grid.Row="0"
            Panel.ZIndex="30"
            Padding="32"
            Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}"
            Visibility="Collapsed"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="CodeShot loading">
            <StackPanel
                Width="280"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextBlock.TextAlignment="Center">
                <imaging:CrispImage
                    Width="48"
                    Height="48"
                    Margin="0,0,0,14"
                    HorizontalAlignment="Center"
                    IsHitTestVisible="False"
                    Moniker="{x:Static catalog:KnownMonikers.Camera}" />
                <TextBlock
                    x:Name="LoadingText"
                    Margin="0,0,0,14"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Creating screenshot..."
                    TextWrapping="Wrap" />
                <ProgressBar
                    Height="4"
                    IsIndeterminate="True"
                    AutomationProperties.Name="Screenshot progress" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Visibility="Collapsed" />

                <TextBlock
                    x:Name="DimensionsText"
                    Margin="8,4"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}" />

                <StackPanel Grid.Column="1" Margin="2,1,6,1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button
                        Width="14"
                        Height="18"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="OnZoomOutClick"
                        Content="-"
                        Focusable="False"
                        ToolTip="Zoom out" />
                    <Slider
                        x:Name="ZoomSlider"
                        Width="90"
                        Height="18"
                        Margin="1,0"
                        Minimum="25"
                        Maximum="400"
                        SmallChange="10"
                        LargeChange="25"
                        Style="{StaticResource ZoomSliderStyle}"
                        TickFrequency="25"
                        Value="100"
                        ValueChanged="OnZoomChanged"
                        ToolTip="Preview zoom" />
                    <Button
                        Width="14"
                        Height="18"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="OnZoomInClick"
                        Content="+"
                        Focusable="False"
                        ToolTip="Zoom in" />
                    <TextBlock
                        Width="38"
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding ElementName=ZoomSlider, Path=Value, StringFormat={}{0:0}%}"
                        TextAlignment="Left"
                        Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

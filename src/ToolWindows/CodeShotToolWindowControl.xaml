<UserControl
    x:Class="CodeShot.ToolWindows.CodeShotToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <Grid x:Name="RootGrid" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="CommandBarBorder" Grid.Row="0" Padding="10" CornerRadius="5" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Margin="0,0,8,0" Padding="12,5" MinWidth="92" Content="Refresh" Click="RefreshButton_OnClick" />
                    <Button x:Name="CopyButton" Margin="0,0,8,0" Padding="12,5" MinWidth="92" Content="Copy PNG" Click="CopyButton_OnClick" />
                    <Button x:Name="SaveButton" Margin="0,0,8,0" Padding="12,5" MinWidth="92" Content="Save PNG" Click="SaveButton_OnClick" />
                </WrapPanel>

                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <CheckBox x:Name="ShowLineNumbersCheckBox" Margin="0,0,14,0" VerticalAlignment="Center" IsChecked="True" Checked="PreviewOptionChanged" Unchecked="PreviewOptionChanged" Content="Line numbers" />
                    <CheckBox x:Name="ShowTitleBarCheckBox" VerticalAlignment="Center" IsChecked="True" Checked="PreviewOptionChanged" Unchecked="PreviewOptionChanged" Content="Title bar" />
                </WrapPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" x:Name="StatusText" Margin="2,0,0,10" Opacity="0.85" Text="Select code in the editor, then click Refresh." />

        <Border
            Grid.Row="2"
            x:Name="CaptureSurface"
            Padding="18"
            Background="#FFABB8C3"
            CornerRadius="8"
            SnapsToDevicePixels="True">
            <Border
                x:Name="SnapshotFrame"
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                CornerRadius="5"
                BorderThickness="0.5"
                BorderBrush="#22000000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="TitleBarBorder" Grid.Row="0" Margin="0,0,0,10" Padding="12,9,12,9">
                        <DockPanel x:Name="TitleBar" LastChildFill="True">
                            <TextBlock x:Name="TitleText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="12,0,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                x:Name="LineNumbersText"
                                FontFamily="Consolas"
                                FontSize="13"
                                TextAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0" />

                            <RichTextBox
                                Grid.Column="2"
                                x:Name="PreviewRichText"
                                IsReadOnly="True"
                                IsDocumentEnabled="False"
                                BorderThickness="0"
                                Background="Transparent"
                                FontFamily="Consolas"
                                FontSize="13"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"
                                Padding="0"
                                Margin="0"
                                AcceptsTab="True" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>

<UserControl
    x:Class="CodeShot.ToolWindows.CodeShotToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
    toolkit:Themes.UseVsTheme="True"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            x:Name="CaptureSurface"
            Margin="10"
            Padding="18"
            CornerRadius="8"
            SnapsToDevicePixels="True">
            <Border
                x:Name="SnapshotFrame"
                CornerRadius="5"
                BorderThickness="1"
                SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="TitleBarBorder" Grid.Row="0" Margin="0,0,0,10" Padding="12,7" CornerRadius="5,5,0,0">
                        <DockPanel x:Name="TitleBar" LastChildFill="True">
                            <TextBlock x:Name="TitleText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="12,0,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                x:Name="LineNumbersText"
                                FontFamily="Consolas"
                                FontSize="13"
                                TextAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0" />

                            <RichTextBox
                                Grid.Column="2"
                                x:Name="PreviewRichText"
                                IsReadOnly="True"
                                IsDocumentEnabled="False"
                                BorderThickness="0"
                                Background="Transparent"
                                FontFamily="Consolas"
                                FontSize="13"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"
                                Padding="0"
                                Margin="0"
                                AcceptsTab="True" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}">
            <TextBlock
                x:Name="StatusText"
                Margin="8,4"
                TextTrimming="CharacterEllipsis"
                Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}"
                Text="Select code in the editor to update the preview." />
        </Border>
    </Grid>
</UserControl>

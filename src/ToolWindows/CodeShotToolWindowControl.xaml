<UserControl
    x:Class="CodeShot.ToolWindows.CodeShotToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
    toolkit:Themes.UseVsTheme="True"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            Padding="10">
            <!-- The capture surface is the exported image, so it must never be clipped to the viewport. -->
            <Border
                x:Name="CaptureSurface"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                SnapsToDevicePixels="True">
                <Border
                    x:Name="SnapshotFrame"
                    MinWidth="320"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border x:Name="TitleBarBorder" Grid.Row="0" Margin="0,0,0,10" Padding="12,7">
                                    <DockPanel x:Name="TitleBar" LastChildFill="True">
                                        <StackPanel
                                            x:Name="MacWindowControls"
                                            DockPanel.Dock="Left"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"
                                            Visibility="Collapsed">
                                            <Ellipse Width="11" Height="11" Margin="0,0,7,0" Fill="#FF5F57" />
                                            <Ellipse Width="11" Height="11" Margin="0,0,7,0" Fill="#FEBC2E" />
                                            <Ellipse Width="11" Height="11" Fill="#28C840" />
                                        </StackPanel>

                                        <StackPanel
                                            x:Name="WindowsWindowControls"
                                            DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0"
                                            Visibility="Collapsed">
                                            <!-- Segoe MDL2 Assets ships with Windows and carries the real caption glyphs. -->
                                            <TextBlock x:Name="MinimizeGlyph" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,14,0" Text="&#xE921;" />
                                            <TextBlock x:Name="MaximizeGlyph" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,14,0" Text="&#xE922;" />
                                            <TextBlock x:Name="CloseGlyph" FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE8BB;" />
                                        </StackPanel>

                                        <TextBlock x:Name="TitleText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                    </DockPanel>
                                </Border>

                                <Grid x:Name="CodeArea" Grid.Row="1" Margin="12,0,12,12" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- The highlight sits under the text and the dimming over it, so the
                                         code stays legible while the lines around it recede. -->
                                    <Canvas
                                        x:Name="HighlightLayer"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Panel.ZIndex="0"
                                        IsHitTestVisible="False" />

                                    <TextBlock
                                        Grid.Column="0"
                                        Panel.ZIndex="1"
                                        x:Name="LineNumbersText"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        TextAlignment="Right"
                                        VerticalAlignment="Top" />

                                    <TextBlock
                                        Grid.Column="2"
                                        Panel.ZIndex="1"
                                        x:Name="PreviewText"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        TextWrapping="NoWrap"
                                        VerticalAlignment="Top" />

                                    <Canvas
                                        x:Name="DimLayer"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Panel.ZIndex="2"
                                        IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </ScrollViewer>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}">
            <TextBlock
                x:Name="StatusText"
                Margin="8,4"
                TextTrimming="CharacterEllipsis"
                Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}"
                Text="Select code in the editor to update the preview." />
        </Border>
    </Grid>
</UserControl>
